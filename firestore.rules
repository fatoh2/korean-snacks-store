rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email in [
          'fatoh.haj@gmail.com',
          'noorabutamam304@gmail.com'
        ];
    }

    function validOrder() {
      let order = request.resource.data;
      return order.keys().hasOnly([
          'userId', 'customerName', 'phone', 'address', 'notes', 'items',
          'subtotal', 'discount', 'promoCode', 'shipping', 'total', 'status', 'date'
        ])
        && order.customerName is string
        && order.customerName.size() > 0
        && order.customerName.size() <= 120
        && order.phone is string
        && order.phone.size() >= 7
        && order.phone.size() <= 20
        && order.address is map
        && order.address.keys().hasOnly(['city', 'district', 'street', 'building'])
        && order.address.city is string
        && order.address.street is string
        && order.notes is string
        && order.notes.size() <= 1000
        && order.items is list
        && order.items.size() > 0
        && order.items.size() <= 100
        && order.subtotal is number
        && order.subtotal >= 0
        && order.discount is number
        && order.discount >= 0
        && order.discount <= order.subtotal
        && order.shipping in [0, 15]
        && order.total is number
        && order.total == order.subtotal - order.discount + order.shipping
        && order.status == 'pending'
        && order.date is string
        && (order.userId == null || (signedIn() && order.userId == request.auth.uid));
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promoCodes/{code} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if validOrder();
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /wishlists/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['productIds'])
        && request.resource.data.productIds is list
        && request.resource.data.productIds.size() <= 500;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
